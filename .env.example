# Supabase — from your project's API settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key (sb_secret_...) — SERVER ONLY. Bypasses row-level security.
# Used by Stripe webhooks, the MCP server, and admin operations.
# Never expose to the browser or commit the real value.
# (Legacy fallback: SUPABASE_SERVICE_ROLE_KEY also works.)
SUPABASE_SECRET_KEY=sb_secret_...

# Anthropic — for the server-side onboarding wizard (writes profile prose
# from interview answers). PorchLyte's own key.
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — drives membership status/plan via webhooks (POST /api/stripe/webhook)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Maps Stripe price IDs to PorchLyte plans. Lets Tracy change what a tier
# includes without a code deploy. Fill with the real price IDs once the Stripe
# products exist. Falls back to subscription metadata `plan`, then "foundations".
STRIPE_PRICE_MAP={"price_xxx_foundations":"foundations","price_xxx_full":"full"}

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
